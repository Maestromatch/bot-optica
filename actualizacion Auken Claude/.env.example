# =============================================================
# AUKÉN — Variables de entorno (Fase 1)
# Copia este archivo como .env.local y completa los valores.
# En Vercel, agrégalas vía Project Settings → Environment Variables.
# =============================================================

# --- ANTHROPIC (Claude) ---
# Reemplaza Groq como cerebro principal del chat.
# Obtener: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXX
VITE_ANTHROPIC_API_KEY=sk-ant-api03-XXXX

# --- SUPABASE ---
# URL pública del proyecto
SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Anon key (frontend, RLS activo)
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Service role key (backend, bypassa RLS) — ¡NUNCA exponer al cliente!
# Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# --- WHATSAPP META CLOUD API ---
WHATSAPP_TOKEN=EAAVoaaf...
PHONE_NUMBER_ID=1161314060388908
WHATSAPP_VERIFY_TOKEN=auken_secreto_2026
ESCALATION_PHONE=+56954932802

# --- WORKER SECRETS ---
# Token interno para que el webhook pueda invocar al worker
# Genera uno aleatorio largo (ej: openssl rand -hex 32)
WORKER_SECRET=cambiar-por-uno-aleatorio-largo
CRON_SECRET=cambiar-por-otro-aleatorio-largo

# --- GROQ (legacy, solo para OCR de recetas) ---
# El chat ya NO usa Groq, solo /api/vision.js para visión
GROQ_API_KEY=gsk_xxx

# --- VAPI (voz, opcional Fase 1) ---
VITE_VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
VITE_VAPI_ASSISTANT_ID=
