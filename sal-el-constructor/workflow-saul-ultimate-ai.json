{
  "name": "Saul el Constructor - ULTIMATE AI FLOW",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "folderId": "TU_FOLDER_DRIVE_ID",
        "event": "fileCreated",
        "options": {}
      },
      "name": "Google Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        100,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-3.5-turbo\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Eres el community manager experto de 'Saúl el Constructor' en Santiago de Chile. Tu tono es profesional, técnico y genera confianza. Escribes posts para Instagram con emojis y hashtags locales.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Crea una descripción vendedora para una publicación basada en este título de obra: {{$node[\\\"Google Drive Trigger\\\"].json[\\\"name\\\"]}}. Incluye hashtags como #Santiago #Remodelacion #ConstruccionChile y una invitación a escribir al WhatsApp.\"\n    }\n  ]\n}",
        "options": {}
      },
      "name": "Generador de Copy IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        350,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "TU_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$node[\"Google Drive Trigger\"].json[\"fileExtension\"]}}",
              "operation": "contains",
              "value2": "mp4"
            }
          ]
        }
      },
      "name": "Es Video?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        600,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/17841444240694094/media",
        "sendQueryParameters": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "=https://drive.google.com/uc?export=download&id={{$node[\"Google Drive Trigger\"].json[\"id\"]}}"
            },
            {
              "name": "caption",
              "value": "={{$node[\"Generador de Copy IA\"].json[\"choices\"][0][\"messageDefault\"][\"content\"]}}"
            },
            {
              "name": "access_token",
              "value": "TU_TOKEN_AQUI"
            }
          ]
        },
        "options": {}
      },
      "name": "Publicar Foto AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Google Drive Trigger": {
      "main": [
        [
          {
            "node": "Generador de Copy IA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generador de Copy IA": {
      "main": [
        [
          {
            "node": "Es Video?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Es Video?": {
      "main": [
        [
          {
            "node": "Publicar Foto AI",
            "type": "main",
            "index": 1
          }
        ]
      ]
    }
  }
}
