            {
              "name": "caption",
              "value": "={{$node[\"Google Drive Trigger\"].json[\"name\"]}}"
            },
            {
              "name": "access_token",
              "value": "TU_TOKEN_AQUI"
            }
          ]
        },
        "options": {}
