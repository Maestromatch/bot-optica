            },
            {
              "name": "caption",
              "value": "={{$node[\"Google Drive Trigger\"].json[\"name\"]}}"
            },
            {
              "name": "access_token",
              "value": "TU_TOKEN_AQUI"
            }
          ]
        },
        "options": {}
      },
      "name": "Publicar Foto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/17841444240694094/media",
        "sendQueryParameters": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "video_url",
              "value": "=https://drive.google.com/uc?export=download&id={{$node[\"Google Drive Trigger\"].json[\"id\"]}}"
            },
            {
              "name": "media_type",
              "value": "VIDEO"
