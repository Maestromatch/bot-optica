        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-3.5-turbo\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Eres el community manager de Saúl el Constructor. Crea un copy viral para TikTok e Instagram basado en: {{$node[\\\"Google Drive Trigger\\\"].json[\\\"name\\\"]}}. Usa hashtags como #Santiago #MaestroSaul #Construccion.\"\n    }\n  ]\n}",
        "options": {}
      },
      "name": "Generar Copy Viral",
