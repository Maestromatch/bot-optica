        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $node['Webhook Z-API Recepci\u00f3n'].json['phone'] }}\",\n  \"message\": \"{{ $json.choices[0].message.content }}\"\n}",
