      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$node[\"Repetidor (Uno por uno)\"].json[\"fileExtension\"]}}",
              "operation": "contains",
              "value2": "mp4"
            }
          ]
        }
      },
      "name": "Detectar Video?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        750,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/17841444240694094/media",
        "sendQueryParameters": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "video_url",
              "value": "=https://drive.google.com/uc?export=download&id={{$node[\"Repetidor (Uno por uno)\"].json[\"id\"]}}"
            },
            {
              "name": "media_type",
              "value": "VIDEO"
            },
            {
              "name": "caption",
              "value": "={{$node[\"IA de Agencia (Hooks)\"].json[\"choices\"][0][\"message\"][\"content\"]}}"
            },
            {
              "name": "access_token",
              "value": "TU_TOKEN_AQUI"
            }
          ]
        },
        "options": {}
      },
