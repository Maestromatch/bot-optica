        "jsonBody": "={\n  \"model\": \"gpt-3.5-turbo\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Eres una agencia de marketing de élite para constructoras. Tu especialidad son los 'Hooks' (ganchos) que detienen el scroll. Tu tono es de autoridad técnica, premium y directo.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Crea un post para Instagram basado en este archivo: {{$node[\\\"Repetidor (Uno por uno)\\\"].json[\\\"name\\\"]}}. Estructura: 1. Hook impactante. 2. Valor técnico (SIP, calidad, plazos). 3. CTA (Llamada a la acción al WhatsApp). 4. Hashtags estratégicos.\"\n    }\n  ]\n}",
        "options": {}
      },
      "name": "IA de Agencia (Hooks)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        400
      ]
