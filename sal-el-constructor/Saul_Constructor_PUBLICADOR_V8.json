    {
      "id": "carrusel-003",
      "name": "Code - Filtrar Imagenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 1380],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Toma la respuesta de Google Drive API y filtra solo imágenes\nconst input = $input.first().json;\nconst files = input.files || [];\n\n// Filtrar solo archivos de imagen\nconst imageFiles = files.filter(file => {\n  const name = (file.name || '').toLowerCase();\n  const mime = (file.mimeType || '');\n  return (\n    mime.startsWith('image/') ||\n    name.endsWith('.jpg') ||\n    name.endsWith('.jpeg') ||\n    name.endsWith('.png') ||\n    name.endsWith('.webp')\n  );\n});\n\n// Instagram permite máximo 10 imágenes en carrusel\nconst toProcess = imageFiles.slice(0, 10);\n\nreturn [{\n  json: {\n    count: toProcess.length,\n    fileIds: toProcess.map(f => f.id),\n    fileIdsJson: JSON.stringify(toProcess.map(f => f.id)),\n    firstFileName: (toProcess[0]?.name || 'Proyecto Constructor Saul').replace(/\\.[^/.]+$/, ''),\n    allFileNames: toProcess.map(f => f.name).join(', ')\n  }\n}];"
      }
    },

