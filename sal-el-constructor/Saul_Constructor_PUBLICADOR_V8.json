      "position": [3200, 1340],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Recolecta todos los IDs de los containers individuales y los une\nconst items = $input.all();\nconst ids = items.map(item => item.json.id).filter(Boolean);\n\nif (ids.length < 2) {\n  throw new Error(`Solo se crearon ${ids.length} items de carrusel. Se necesitan al menos 2. Revisa que las imágenes sean accesibles públicamente en Drive.`);\n}\n\n// Recupera el caption del nodo Set (más arriba en el flujo)\nlet caption = '';\ntry {\n  caption = $('Set - Caption y FileIds').first().json.caption || '';\n} catch(e) {\n  caption = '🏗️ Nuevo proyecto terminado! #SaulElConstructor #PanelSIPChile';\n}\n\nreturn [{\n  json: {\n    children: ids.join(','),\n    count: ids.length,\n    caption,\n    itemIds: ids\n  }\n}];"
      }
