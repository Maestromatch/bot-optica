      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Toma 1 item con fileIdsJson y lo expande a N items (uno por imagen)\nconst item = $input.first().json;\nconst fileIds = JSON.parse(item.fileIdsJson || '[]');\nconst caption = item.caption || '🏗️ Nuevo proyecto terminado! Desliza para ver el proceso. #SaulElConstructor';\n\nif (!fileIds.length) {\n  throw new Error('No hay fileIds para expandir');\n}\n\n// Retorna un item por cada imagen del carrusel\nreturn fileIds.map((fileId, index) => ({\n  json: {\n    fileId,\n    imageUrl: `https://drive.google.com/uc?export=download&id=${fileId}`,\n    caption,\n    slotIndex: index,\n    totalSlots: fileIds.length\n  }\n}));"
      }
    },

